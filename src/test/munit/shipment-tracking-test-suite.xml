        http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

    <munit:config name="munit"/>

    <!-- TEST 1: Valid Blue Dart event -->
    <munit:test name="valid-blue-dart-test"
                description="Accepts and publishes a Blue Dart event">

        <munit:behavior>
            <munit-tools:mock-when processor="vm:publish">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[payload]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit:set-event>
                <munit:payload mediaType="application/java"
                    value="#[{
                      trackingNumber: 'BD123456',
                      carrier: 'BLUE DART',
                      eventId: 'EVT1001',
                      status: 'In Transit',
                      location: 'Hyderabad',
                      timestamp: '2026-10-13T10:00:00'
                    }]"/>
            </munit:set-event>

            <flow-ref name="post:\shipment-events:application\json:shipment-tracking-config"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                expression="#[payload.message]"
                is="#[MunitTools::equalTo('Event accepted')]"/>

            <munit-tools:verify-call processor="vm:publish" times="1"/>
        </munit:validation>
    </munit:test>


