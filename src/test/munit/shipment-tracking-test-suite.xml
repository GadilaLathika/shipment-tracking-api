    <!-- TEST 9: Latest shipment exists -->
    <munit:test name="get-shipment-found-test"
                description="Returns the latest shipment event">

        <munit:behavior>
            <munit-tools:mock-when processor="db:select">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java"
                        value="#[[
                          {
                            trackingNumber: 'BD123456',
                            carrier: 'BLUEDART',
                            status: 'IN_TRANSIT',
                            location: 'Hyderabad',
                            eventTimestamp: '2026-10-13T17:00:00'
                          }
                        ]]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit:set-event>
                <munit:attributes
                    value="#[{uriParams: {trackingNumber: 'BD123456'}}]"
                    mediaType="application/java"/>
            </munit:set-event>

            <flow-ref name="get:\shipments\(trackingNumber):shipment-tracking-config"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                expression="#[payload.trackingNumber]"
                is="#[MunitTools::equalTo('BD123456')]"/>

            <munit-tools:assert-that
                expression="#[payload.status]"
                is="#[MunitTools::equalTo('IN_TRANSIT')]"/>
        </munit:validation>
    </munit:test>


