    <!-- TEST 11: Shipment history with multiple events -->
    <munit:test name="get-shipment-history-test"
                description="Returns the complete shipment event history">

        <munit:behavior>
            <munit-tools:mock-when processor="db:select">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java"
                        value="#[[
                          {
                            trackingNumber: 'BD123456',
                            carrier: 'BLUEDART',
                            eventId: 'EVT1002',
                            status: 'IN_TRANSIT',
                            location: 'Hyderabad',
                            eventTimestamp: '2026-10-13T17:00:00'
                          },
                          {
                            trackingNumber: 'BD123456',
                            carrier: 'BLUEDART',
                            eventId: 'EVT1001',
                            status: 'PICKED_UP',
                            location: 'Chennai',
                            eventTimestamp: '2026-10-12T10:00:00'
                          }
                        ]]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit:set-event>
                <munit:attributes
                    value="#[{uriParams: {trackingNumber: 'BD123456'}}]"
                    mediaType="application/java"/>
            </munit:set-event>

            <flow-ref name="get:\shipments\(trackingNumber)\events:shipment-tracking-config"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                expression="#[payload.trackingNumber]"
                is="#[MunitTools::equalTo('BD123456')]"/>

            <munit-tools:assert-that
                expression="#[sizeOf(payload.events)]"
                is="#[MunitTools::equalTo(2)]"/>

            <munit-tools:assert-that
                expression="#[payload.events[0].eventId]"
                is="#[MunitTools::equalTo('EVT1002')]"/>
        </munit:validation>
    </munit:test>


